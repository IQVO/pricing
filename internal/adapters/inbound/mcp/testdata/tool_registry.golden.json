    "description": "Read what one catalogue item sells for: its state (ACTIVE or WITHDRAWN), the list price, the effective price at this instant (the running sale price, else the list price), every sale window (saleId, price, from and to instants) and the version. Amounts are minor units of the stated currency. Read-only; an item with no price fails with not-found.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "catalogItemId": {
          "description": "the catalogue item id whose price is read, e.g. sku-1",
          "type": "string"
        }
      },
      "required": [
        "catalogItemId"
      ],
      "type": "object"
    },
    "name": "get_item_price",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
