              "type": "integer"
            },
            "currency": {
              "type": "string"
            }
          },
          "required": [
            "amountMinor",
            "currency"
          ],
          "type": "object"
        },
        "listPrice": {
          "additionalProperties": false,
          "properties": {
            "amountMinor": {
