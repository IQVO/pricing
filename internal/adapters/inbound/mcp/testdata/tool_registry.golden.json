            "currency"
          ],
          "type": "object"
        },
        "sales": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "price": {
                "additionalProperties": false,
                "properties": {
                  "amountMinor": {
                    "type": "integer"
                  },
                  "currency": {
                    "type": "string"
                  }
                },
                "required": [
                  "amountMinor",
                  "currency"
                ],
                "type": "object"
              },
              "saleId": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "saleId",
              "price",
              "from",
              "to"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "state": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
